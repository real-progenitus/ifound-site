# Environment Variables
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Resend (transactional email — partner inquiry form)
RESEND_API_KEY=re_your-api-key-here

# Stripe (shop checkout). Secret key only — the site creates hosted Checkout
# Sessions and never touches card data, so there is no publishable key. The
# webhook that fulfills orders lives in ifound-functions, so no webhook secret
# belongs here either.
# Only needed once the shop is switched on in Dynamic/shop_config. While it is
# off, checkout short-circuits before Stripe is ever constructed.
STRIPE_SECRET_KEY=sk_live_your-key-here
# Stripe test key for the shop's hidden QA mode (12 taps on the "works with"
# line of the shop page). Optional: without it QA checkouts fail and production
# checkout is unaffected. Use the same test key as STRIPE_SECRET_KEY_QA in
# Secret Manager, so QA orders reach stripeShopWebhookQA.
STRIPE_SECRET_KEY_QA=sk_test_your-key-here
